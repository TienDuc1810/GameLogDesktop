<Window x:Class="GameLogDesktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#151B25" Foreground="#E7EFFB" FontFamily="Segoe UI" FontSize="14" Title="GameLog Desktop" Width="1500" Height="950" MinWidth="1050" MinHeight="700" WindowState="Maximized" Closing="WindowClosing">
 <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,16"><TextBlock Text="GAMELOG" FontSize="24" FontWeight="Bold" Foreground="#A9CEF0" Margin="0,0,24,0"/>
   <WrapPanel><Button Content="Chức năng ▾" Click="FunctionsClick"/><Button Content="Nhập dữ liệu cũ" Click="ImportOld"/><Button Content="Thêm game" Click="AddGame"/><Button Content="Cài đặt Steam" Click="SettingsClick"/><Button Content="Sao lưu" Click="BackupClick"/><Button Content="Mở dữ liệu" Click="OpenData"/><Button Content="Kiểm tra cập nhật" Click="CheckUpdates"/><Button x:Name="NotificationsButton" Content="Thông báo (0)" Click="OpenNotifications"/><Button x:Name="CancelButton" Content="Huỷ tác vụ" Click="CancelTask" Visibility="Collapsed"/></WrapPanel>
  </DockPanel>
  <TabControl Grid.Row="1">
   <TabItem Header="Thư viện / Nhật ký"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="460" MinWidth="380" MaxWidth="620"/></Grid.ColumnDefinitions>
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="160"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions><Grid><TextBox x:Name="Search" TextChanged="FilterChanged" ToolTip="Tìm tên game"/><TextBlock Text="Tìm game…" Foreground="#AFBED1" Margin="12,0" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text,ElementName=Search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid><ComboBox x:Name="StatusFilter" Grid.Column="1" Margin="8,0,0,0" SelectionChanged="FilterChanged"/><ComboBox x:Name="KindFilter" Grid.Column="2" Margin="8,0,0,0" SelectionChanged="FilterChanged"/></Grid>
     <DataGrid x:Name="Library" Grid.Row="1" SelectionChanged="GameSelected"><DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="Background" Value="#B5D5F2"/><Style.Triggers><DataTrigger Binding="{Binding Status}" Value="Muốn chơi"><Setter Property="Background" Value="#FAE8AC"/></DataTrigger><DataTrigger Binding="{Binding Status}" Value="Bỏ dở"><Setter Property="Background" Value="#E5D8EA"/></DataTrigger></Style.Triggers></Style></DataGrid.RowStyle><DataGrid.Columns>
      <DataGridTextColumn Header="STT" Binding="{Binding Number}" Width="55" MinWidth="55" ElementStyle="{StaticResource CenterCell}"/><DataGridTextColumn Header="Tên game" Binding="{Binding Name}" Width="2*" MinWidth="230" ElementStyle="{StaticResource NameCell}"/>
      <DataGridTextColumn Header="Nền tảng" Binding="{Binding Platform}" Width="110" MinWidth="110" ElementStyle="{StaticResource CenterCell}"/><DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="115" MinWidth="115" ElementStyle="{StaticResource CenterCell}"/>
      <DataGridTextColumn Header="Giờ chơi" Binding="{Binding Hours}" Width="105" MinWidth="105" ElementStyle="{StaticResource CenterCell}"/><DataGridTextColumn Header="Lần cuối" Binding="{Binding LastPlayed}" Width="160" MinWidth="160" ElementStyle="{StaticResource CenterCell}"/>
      <DataGridTextColumn Header="Thành tựu" Binding="{Binding AchievementText}" Width="100" MinWidth="100" ElementStyle="{StaticResource CenterCell}"/><DataGridTextColumn Header="Đánh giá" Binding="{Binding RatingText}" Width="150" MinWidth="150" ElementStyle="{StaticResource CenterCell}"/>
     </DataGrid.Columns></DataGrid>
    </Grid><GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" Background="#3E5270"/>
    <TabControl Grid.Column="2" Margin="12,0,0,0"><TabItem Header="Thông tin"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="Details" Margin="10">
     <TextBlock Text="Tên game" Margin="0,0,0,6"/><TextBox Text="{Binding Name,UpdateSourceTrigger=PropertyChanged}" TextAlignment="Center"/>
     <TextBlock Text="Nền tảng" Margin="0,14,0,6"/><ComboBox x:Name="PlatformCombo" SelectedItem="{Binding Platform}"/>
     <TextBlock Text="Phân loại" Margin="0,14,0,6"/><ComboBox x:Name="KindCombo" SelectedItem="{Binding Kind}"/>
     <TextBlock Text="Trạng thái" Margin="0,14,0,6"/><ComboBox x:Name="StatusCombo" SelectedItem="{Binding Status}"/>
     <TextBlock Text="Đánh giá" Margin="0,14,0,6"/><ComboBox x:Name="RatingCombo" SelectedIndex="{Binding RatingIndex}"/>
     <TextBlock Text="Thời gian chơi" Margin="0,14,0,6"/><TextBlock Text="{Binding Hours}" HorizontalAlignment="Center" FontSize="18"/>
     <TextBlock Text="Steam AppID" Margin="0,14,0,6"/><TextBox Text="{Binding AppId}" TextAlignment="Center"/>
     <TextBlock Text="Theo dõi game (tên tiến trình)" Margin="0,14,0,6"/><TextBox Text="{Binding Exe}" TextAlignment="Center" ToolTip="Ví dụ eldenring; tên tiến trình trong Task Manager, không phải tên hiển thị trên Steam"/>
     <TextBlock Text="Ngày thêm" Margin="0,14,0,6"/><TextBlock Text="{Binding Added}" HorizontalAlignment="Center"/>
     <TextBlock Text="Ghi chú" Margin="0,14,0,6"/><TextBox Text="{Binding Notes}" AcceptsReturn="True" TextWrapping="Wrap" Height="140" VerticalScrollBarVisibility="Auto"/>
     <WrapPanel Margin="0,16,0,0"><Button Content="Lưu thay đổi" Click="SaveGame"/><Button Content="Mở game Steam" Click="LaunchGame"/><Button Content="Xoá game" Click="DeleteGame"/></WrapPanel>
    </StackPanel></ScrollViewer></TabItem>
    <TabItem Header="Thành tựu"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><WrapPanel><Button Content="Đồng bộ Steam" Click="SyncAchievements"/><TextBox x:Name="AchievementInput" Width="160" Margin="0,0,8,8" ToolTip="Tên thành tựu nhập tay"/><Button Content="Thêm" Click="AddAchievement"/><Button Content="Xoá mục chọn" Click="DeleteAchievement"/></WrapPanel><DataGrid x:Name="AchievementsGrid" Grid.Row="1" IsReadOnly="False" CellEditEnding="AchievementEdited"><DataGrid.Columns><DataGridCheckBoxColumn Header="Đã mở" Binding="{Binding Done}" Width="65"/><DataGridTextColumn Header="Thành tựu" Binding="{Binding Name}" Width="*" IsReadOnly="True"/><DataGridTextColumn Header="Ngày" Binding="{Binding Date}" Width="150" IsReadOnly="True" MinWidth="150"/></DataGrid.Columns></DataGrid></Grid></TabItem>
    <TabItem Header="Phiên chơi"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><WrapPanel><Button x:Name="TimerButton" Content="Bắt đầu phiên" Click="ToggleSession"/><TextBox x:Name="MinutesInput" Width="100" ToolTip="Số phút"/><Button Content="Thêm phút" Click="ManualSession"/><Button Content="Xoá phiên chọn" Click="DeleteSession"/></WrapPanel><TextBlock x:Name="SessionClock" Margin="0,0,0,8"/></StackPanel><DataGrid x:Name="SessionsGrid" Grid.Row="1"><DataGrid.Columns><DataGridTextColumn Header="Bắt đầu" Binding="{Binding Start}" Width="160" MinWidth="160"/><DataGridTextColumn Header="Phút" Binding="{Binding Minutes}" Width="80" MinWidth="80"/><DataGridTextColumn Header="Nguồn" Binding="{Binding Source}" Width="100" MinWidth="100"/><DataGridTextColumn Header="Ghi chú" Binding="{Binding Note}" Width="*"/></DataGrid.Columns></DataGrid></Grid></TabItem></TabControl>
   </Grid></TabItem>
   <TabItem Header="Wishlist / Theo dõi"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><WrapPanel Margin="0,0,0,8"><Button Content="Đồng bộ Wishlist" Click="SyncWishlist"/><Button Content="Cập nhật giá" Click="RefreshPrices"/><TextBox x:Name="WatchId" Width="120" Margin="0,0,8,8" ToolTip="Steam AppID"/><Button Content="Theo dõi AppID" Click="AddWatch"/><Button Content="Mở Steam" Click="WatchSteam"/><Button Content="SteamDB" Click="WatchDb"/><TextBox x:Name="TargetPrice" Width="145" Margin="0,0,8,8" ToolTip="Số tiền VND"/><Button Content="Lưu giá mục tiêu" Click="SaveTarget"/><Button Content="Lưu mốc SteamDB" Click="SaveDbLow"/></WrapPanel>
    <DataGrid x:Name="WatchGrid" Grid.Row="1"><DataGrid.Columns><DataGridTextColumn Header="STT" Binding="{Binding Number}" Width="55" MinWidth="55" ElementStyle="{StaticResource CenterCell}"/><DataGridTextColumn Header="Tên game" Binding="{Binding Name}" Width="2*" MinWidth="230" ElementStyle="{StaticResource NameCell}"/><DataGridTextColumn Header="Giá VND" Binding="{Binding PriceText}" Width="150" MinWidth="150" ElementStyle="{StaticResource CenterCell}"/><DataGridTextColumn Header="Giá gốc" Binding="{Binding OriginalText}" Width="150" MinWidth="150" ElementStyle="{StaticResource CenterCell}"/><DataGridTextColumn Header="Giảm" Binding="{Binding DiscountText}" Width="100" MinWidth="100" ElementStyle="{StaticResource CenterCell}"/><DataGridTextColumn Header="Thấp nhất ghi nhận" Binding="{Binding LowText}" Width="170" MinWidth="170" ElementStyle="{StaticResource CenterCell}"/><DataGridTextColumn Header="Đối chiếu" Binding="{Binding Verdict}" Width="2*" MinWidth="240"/><DataGridTextColumn Header="Ngày ra mắt" Binding="{Binding Release}" Width="160" MinWidth="160"/><DataGridTextColumn Header="Kiểm tra" Binding="{Binding Checked}" Width="160" MinWidth="160"/></DataGrid.Columns></DataGrid>
   </Grid></TabItem>
   <TabItem Header="Tin game / Bản vá"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="8"/><RowDefinition Height="*"/></Grid.RowDefinitions><WrapPanel><Button Content="Tin game đang chọn" Click="SelectedNews"/><Button Content="Tin các game sở hữu" Click="OwnedNews"/><Button Content="Mở bài gốc" Click="OpenNews"/></WrapPanel><DataGrid x:Name="NewsGrid" Grid.Row="1" SelectionChanged="NewsSelected"><DataGrid.Columns><DataGridTextColumn Header="STT" Binding="{Binding Number}" Width="55" MinWidth="55"/><DataGridTextColumn Header="Game" Binding="{Binding GameName}" Width="220" MinWidth="220"/><DataGridTextColumn Header="Ngày" Binding="{Binding Date}" Width="160" MinWidth="160"/><DataGridTextColumn Header="Tiêu đề" Binding="{Binding Title}" Width="*"/></DataGrid.Columns></DataGrid><GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch" Background="#3E5270"/><TextBox x:Name="NewsBody" Grid.Row="3" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Text="Chọn một bài để đọc. Tin bản vá không xác định phiên bản đang cài và không tự cập nhật game."/></Grid></TabItem>
   <TabItem Header="Sự kiện"><StackPanel Margin="16"><TextBlock Text="Nguồn sự kiện chính thức" FontSize="22" Margin="0,0,0,16"/><WrapPanel><Button Content="Lịch Steam" Click="SteamEvents"/><Button Content="Steam giảm giá" Click="SteamSales"/><Button Content="Epic Games" Click="EpicEvents"/><Button Content="GOG" Click="GogEvents"/></WrapPanel><TextBlock Text="Các liên kết mở nguồn chính thức trong trình duyệt. Lịch sự kiện chưa được tự đồng bộ vào app."/></StackPanel></TabItem>
   <TabItem Header="Việt hoá"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><WrapPanel><Grid Width="280" Margin="0,0,8,8"><TextBox x:Name="TranslationSearch" TextChanged="TranslationFilterChanged" ToolTip="Tìm game trong thư viện"/><TextBlock Text="Tìm game…" Foreground="#AFBED1" Margin="12,0" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text,ElementName=TranslationSearch}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid><Button Content="Cập nhật từ hai nguồn" Click="UpdateTranslations"/><Button Content="Mở The Red Team" Click="OpenTranslationRed"/><Button Content="Mở Cánh Cụt Team" Click="OpenTranslationPenguin"/><Button Content="Dịch game" Click="PrepareLocalization"/><Button Content="Kiểm tra file Việt hoá" Click="InspectLocalization"/></WrapPanel><TextBlock x:Name="TranslationSummary" Margin="0,0,0,12" Foreground="#AFBED1"/></StackPanel>
    <DataGrid x:Name="TranslationGrid" Grid.Row="1" SelectionChanged="TranslationSelected"><DataGrid.Columns>
     <DataGridTextColumn Header="STT" Binding="{Binding Number}" Width="55" MinWidth="55" ElementStyle="{StaticResource CenterCell}"/>
     <DataGridTextColumn Header="Tên game" Binding="{Binding Name}" Width="2*" MinWidth="240" ElementStyle="{StaticResource NameCell}"/>
     <DataGridTextColumn Header="Việt Hóa By The Red Team" Binding="{Binding RedStatus}" Width="*" MinWidth="260" ElementStyle="{StaticResource CenterCell}"/>
     <DataGridTextColumn Header="Việt Hóa By Cánh Cụt Team" Binding="{Binding PenguinStatus}" Width="*" MinWidth="280" ElementStyle="{StaticResource CenterCell}"/>
     <DataGridTextColumn Header="Tự Dịch Việt Hóa" Binding="{Binding DraftStatus}" Width="*" MinWidth="180" ElementStyle="{StaticResource CenterCell}"/>
     <DataGridTextColumn Header="Nhập File Việt Hóa" Binding="{Binding ImportStatus}" Width="*" MinWidth="190" ElementStyle="{StaticResource CenterCell}"/>
    </DataGrid.Columns></DataGrid>
    <Grid Grid.Row="2" Margin="0,12,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBox x:Name="TranslationDetails" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="180"/><TextBlock Grid.Row="1" Margin="0,8,0,0" Foreground="#AFBED1" TextWrapping="Wrap" Text="Không có bản dịch = chưa tìm thấy trong danh mục PC của nguồn ở lần kiểm tra ghi trên. Trả phí bao gồm bản trải nghiệm sớm cần donate. Bản 1.3 thử nghiệm: Metro hỗ trợ đọc câu và dịch nháp; nhập ZIP chỉ kiểm tra cấu trúc, chưa tự cài."/></Grid>
   </Grid></TabItem>
   <TabItem x:Name="NotificationsTab" Header="Thông báo"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,16"><WrapPanel><Button Content="Đánh dấu tất cả đã đọc" Click="MarkNotificationsRead"/><TextBlock x:Name="NotificationSummary" TextWrapping="Wrap" Margin="8,8" Foreground="#A9CEF0"/></WrapPanel><TextBlock Text="Mốc key: 30 ngày từ lần ghi nhận đầu tiên. Kiểm tra khi app đang chạy hoặc lần mở kế tiếp. Key gốc không được lưu vào dữ liệu." TextWrapping="Wrap" Foreground="#AFBED1"/></StackPanel>
    <Grid Grid.Row="1"><TextBlock x:Name="NotificationEmpty" Text="Chưa có thông báo" FontSize="20" Foreground="#AFBED1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
     <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="NotificationList"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#202A39" BorderBrush="#40536D" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,12"><StackPanel><DockPanel><TextBlock Text="{Binding ReadText}" DockPanel.Dock="Right" Foreground="#A9CEF0" Margin="16,0,0,0"/><TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/></DockPanel><TextBlock Margin="0,6,0,10" Foreground="#AFBED1"><Run Text="{Binding DateText,Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Level,Mode=OneWay}"/></TextBlock><TextBlock Text="{Binding Message}" TextWrapping="Wrap"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
    </Grid>
   </Grid></TabItem>
  </TabControl>
  <Border Grid.Row="2" Background="#202A39" CornerRadius="6" Padding="12,10" Margin="0,14,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="Notice" TextWrapping="Wrap" Text="Sẵn sàng. Nhập games.json để chuyển dữ liệu từ app PowerShell."/><TextBlock x:Name="Stats" Grid.Column="1" Margin="16,0,0,0"/></Grid></Border>
 </Grid>
</Window>







