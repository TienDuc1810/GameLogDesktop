<Window x:Class="GameLogDesktop.LocalizationWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Chuẩn bị Việt hoá" Width="1140" Height="760" MinWidth="820" MinHeight="580" WindowStartupLocation="CenterOwner" Background="#171E29" Foreground="#E7EFFB">
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,16"><TextBlock x:Name="GameTitle" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Kiểm tra tài nguyên trước khi dịch hoặc cài gói Việt hoá" Margin="0,8,0,0" Foreground="#AFBED1"/></StackPanel>
  <Grid Grid.Row="1" Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="Folder" ToolTip="Thư mục cài đặt game"/><Button Grid.Column="1" Content="Chọn thư mục game" Click="ChooseFolder"/><Button x:Name="ScanButton" Grid.Column="2" Content="Quét tài nguyên" Click="Scan"/></Grid>
  <TabControl Grid.Row="2" x:Name="Tabs">
   <TabItem Header="Tài nguyên game"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock x:Name="Engine" Text="Chọn đúng thư mục mở từ Steam → Quản lý → Duyệt tệp cục bộ." TextWrapping="Wrap" Margin="0,0,0,12"/>
    <DataGrid x:Name="ResourceGrid" Grid.Row="1"><DataGrid.Columns><DataGridTextColumn Header="Đường dẫn" Binding="{Binding RelativePath}" Width="2*"/><DataGridTextColumn Header="Định dạng" Binding="{Binding Format}" Width="110"/><DataGridTextColumn Header="Byte" Binding="{Binding Bytes}" Width="130"/><DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="2*"/></DataGrid.Columns></DataGrid>
    <WrapPanel Grid.Row="2" Margin="0,12,0,0"><Button x:Name="ExportButton" Content="Xuất báo cáo kiểm tra" Click="Export" IsEnabled="False"/><TextBlock Text="Báo cáo chứa danh sách tệp, không chứa nội dung game." VerticalAlignment="Center" Margin="8,0"/></WrapPanel>
   </Grid></TabItem>
   <TabItem Header="Dịch nháp qua OpenAI"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Visibility="Collapsed" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions><TextBlock Text="API key" Margin="0,0,12,0" VerticalAlignment="Center"/><PasswordBox x:Name="ApiKey" Grid.Column="1" Padding="10" Background="#263244" Foreground="#E7EFFB" PasswordChanged="CredentialsChanged"/><Button Grid.Column="2" Content="Ghi nhận key · 30 ngày" Click="RegisterKey"/><TextBlock Text="Model" Grid.Column="3" Margin="8,0,12,0" VerticalAlignment="Center"/><TextBox x:Name="Model" Grid.Column="4" Text="gpt-4.1-mini" TextChanged="CredentialsChanged"/></Grid>
    <TextBlock x:Name="KeyCountdown" Grid.Row="1" Text="Chưa ghi nhận API key" TextWrapping="Wrap" Foreground="#A9CEF0" Margin="0,0,0,12"/>
    <WrapPanel Grid.Row="2" Margin="0,0,0,8"><Button x:Name="GameTranslateButton" Content="Dịch game" Click="TranslateGame"/><Button x:Name="SharedKeyButton" Content="API key dùng chung" Click="SharedKeySettings"/><Button Visibility="Collapsed" x:Name="ReadTextButton" Content="Đọc câu tiếng Anh từ Metro" Click="ReadText"/><Button Visibility="Collapsed" x:Name="EstimateButton" Content="Tính token và chi phí" Click="EstimateCost" IsEnabled="False"/><Button Visibility="Collapsed" x:Name="TranslateButton" Content="Dịch 20 câu · tối đa 1 USD/lần" Click="TranslateSample" IsEnabled="False"/><Button x:Name="CancelTranslationButton" Content="Dừng" Click="CancelTranslation" IsEnabled="False"/><Button Visibility="Collapsed" x:Name="ExportDraftButton" Content="Xuất bản nháp JSON" Click="ExportDraft" IsEnabled="False"/></WrapPanel>
    <Border Visibility="Collapsed" Grid.Row="3" Background="#263244" CornerRadius="6" Padding="12" Margin="0,0,0,12"><TextBlock x:Name="CostSummary" Text="Đọc câu và ghi nhận key, sau đó tính chi phí. Vượt 1 USD hoặc không xác minh được giá/token: app chặn dịch." TextWrapping="Wrap"/></Border>
    <DataGrid x:Name="TextGrid" Grid.Row="4"><DataGrid.Columns><DataGridTextColumn Header="Mã câu" Binding="{Binding Id}" Width="*" ElementStyle="{StaticResource NameCell}"/><DataGridTextColumn Header="Câu gốc" Binding="{Binding Source}" Width="2*" ElementStyle="{StaticResource NameCell}"/><DataGridTextColumn Header="Bản dịch tiếng Việt" Binding="{Binding Vietnamese}" Width="2*" ElementStyle="{StaticResource NameCell}"/></DataGrid.Columns></DataGrid>
    <TextBlock Grid.Row="5" Text="Key dùng chung được Windows mã hóa. Bản dịch tự lưu JSON; chưa áp dụng vào game." TextWrapping="Wrap" Foreground="#EBD698" Margin="0,12,0,0"/>
   </Grid></TabItem>
   <TabItem Header="Kiểm tra file Việt hoá"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><WrapPanel Margin="0,0,0,12"><Button Content="Chọn gói ZIP" Click="InspectPackage"/><TextBlock Text="Xem đường dẫn và định dạng trước khi cài" VerticalAlignment="Center" Margin="8,0"/></WrapPanel>
    <DataGrid x:Name="PackageFiles" Grid.Row="1"><DataGrid.Columns><DataGridTextColumn Header="Đường dẫn trong gói" Binding="{Binding RelativePath}" Width="2*"/><DataGridTextColumn Header="Định dạng" Binding="{Binding Format}" Width="110"/><DataGridTextColumn Header="Byte" Binding="{Binding Bytes}" Width="130"/><DataGridTextColumn Header="Kiểm tra" Binding="{Binding Status}" Width="2*"/></DataGrid.Columns></DataGrid>
    <TextBlock Grid.Row="2" Text="Bước này kiểm tra cấu trúc ZIP và chặn tệp thực thi rõ ràng. Chưa quét mã độc, chưa xác minh tương thích và chưa ghi vào game." TextWrapping="Wrap" Foreground="#EBD698" Margin="0,12,0,0"/>
   </Grid></TabItem>
  </TabControl>
  <TextBlock x:Name="Status" Grid.Row="3" Margin="0,16,0,0" TextWrapping="Wrap" Foreground="#AFBED1" Text="Metro cần bộ xử lý archive và font phù hợp trước khi có thể áp dụng bản dịch."/>
 </Grid>
</Window>

